# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────────────
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET_CLIPS=sentinel-clips

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
JWT_SECRET=your_jwt_secret_min_32_chars

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Firebase FCM ──────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_JSON=./infra/firebase-service-account.json

# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Edge Server ───────────────────────────────────────────────────────────────
EDGE_API_KEY=change_me_edge_api_key
YOLO_MODEL_PATH=models/yolov8x-pose.pt
REID_MODEL_PATH=models/osnet_x1_0.pth
CAMERA_SOURCES=rtsp://cam1:554/stream,rtsp://cam2:554/stream

# ── Backend ───────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_backend_secret_key
ENVIRONMENT=development
LOG_LEVEL=INFO
